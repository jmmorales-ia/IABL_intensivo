# Connection con pooler de Supabase (pgbouncer, modo "Transaction", puerto 6543)
# Usado en runtime por la app (Prisma Client)
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Connection directa de Supabase (puerto 5432, sin pooler)
# Usado solo por Prisma para migraciones (prisma migrate deploy / dev)
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Contraseña del panel de administrador (elige una fuerte)
ADMIN_PASSWORD="cambia-esto"
